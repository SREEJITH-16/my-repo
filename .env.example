# Copy this file to .env (local dev) and set the same keys in your Vercel
# project settings (Project → Settings → Environment Variables) for production.
# Never commit the real .env file.

# ---- Admin CMS ----
# Password required to sign in at /admin. Choose a strong, unique value.
ADMIN_PASSWORD=

# Random 32+ character string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# ---- CMS publishing (optional) ----
# Only needed if you want the /admin dashboard's "Publish Changes" button to
# actually commit content edits back to GitHub (which then triggers a Vercel
# redeploy). Without these, you can still log in and edit, but Publish will
# show a message explaining that publishing isn't configured.
#
# A fine-grained GitHub Personal Access Token with "Contents: Read and write"
# permission, scoped to this one repository.
GITHUB_TOKEN=
# "owner/repo", e.g. SREEJITH-16/Sreejith-Portfolio
GITHUB_REPO=
# Branch to commit to. Defaults to "main" if not set.
GITHUB_BRANCH=main
# Path to the content file within the repo. Defaults to src/content/data.json.
CONTENT_FILE_PATH=src/content/data.json

# ---- Contact form (optional) ----
# EmailJS is already wired with working defaults baked into the code (the
# same ones the original portfolio shipped with, since EmailJS public keys
# are designed to be used client-side). Override only if you create your own
# EmailJS account/service/template.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
